 name="option-space" /&gt;
 &lt;label class="btn btn-outline-primary" for="option-nospace"&gt;
 スペースなし
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="btn-group mb-1 text-nowrap"&gt;
 &lt;input
 class="btn-check"
 id="option-line"
 type="radio"
 name="option-line"
 checked /&gt;
 &lt;label class="btn btn-outline-primary" for="option-line"&gt;
 改行あり
 &lt;/label&gt;
 &lt;input
 class="btn-check"
 id="option-noline"
 type="radio"
 name="option-line" /&gt;
 &lt;label class="btn btn-outline-primary" for="option-noline"&gt;
 改行なし
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;/div&gt;

 &lt;div class="advanced mb-3"&gt;
 &lt;div class="form-check"&gt;
 &lt;input class="form-check-input" type="checkbox" id="mode-consecutive" /&gt;
 &lt;label class="form-check-label" for="mode-consecutive"&gt;
 連続文字検索モード (試験的機能)
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="mode-consecutive" style="display: none"&gt;
 &lt;div class="d-flex flex-column gap-2 mt-2"&gt;
 &lt;div class="card"&gt;
 &lt;div class="card-header"&gt;検索オプション&lt;/div&gt;
 &lt;div class="card-body"&gt;
 &lt;div class="input-group"&gt;
 &lt;span class="input-group-text"&gt;最大検索数&lt;/span&gt;
 &lt;input
 class="form-control"
 type="number"
 id="consecutive-max"
 value="100000" /&gt;
 &lt;/div&gt;
 &lt;span class="form-text"&gt;
 多くても1000000ぐらい推奨、多い程時間がかかります
 &lt;/span&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;div class="card"&gt;
 &lt;div class="card-header"&gt;&lt;span&gt;ランダム項目&lt;/span&gt;&lt;/div&gt;
 &lt;div class="card-body"&gt;
 &lt;span class="form-text"&gt;
 チェックを入れた項目は入力内容にかかわらずランダム化して生成します
 &lt;/span&gt;
 &lt;div class="form-check"&gt;
 &lt;input
 class="form-check-input"
 type="checkbox"
 id="consecutive-random-reward-value" /&gt;
 &lt;label
 class="form-check-label"
 for="consecutive-random-reward-value"&gt;
 報酬値
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="form-check"&gt;
 &lt;input
 class="form-check-input"
 type="checkbox"
 id="consecutive-random-pokemon" /&gt;
 &lt;label
