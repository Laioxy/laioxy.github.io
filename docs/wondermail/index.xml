 for="consecutive-random-pokemon"&gt;
 依頼主・対象ポケモン
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="form-check"&gt;
 &lt;input
 class="form-check-input"
 type="checkbox"
 id="consecutive-random-target-item" /&gt;
 &lt;label
 class="form-check-label"
 for="consecutive-random-target-item"&gt;
 対象の道具
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="form-check"&gt;
 &lt;input
 class="form-check-input"
 type="checkbox"
 id="consecutive-random-seed"
 checked /&gt;
 &lt;label class="form-check-label" for="consecutive-random-seed"&gt;
 Seed
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;/div&gt;

 &lt;div class="d-grid mb-0"&gt;
 &lt;div class="btn-group"&gt;
 &lt;button class="btn btn-primary btn-lg" id="pass-analysis"&gt;
 パスワード展開
 &lt;/button&gt;
 &lt;button class="btn btn-danger btn-lg" id="pass-generate"&gt;
 パスワード生成
 &lt;/button&gt;
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;div class="advanced mt-3 mb-0"&gt;
 &lt;a
 id="mission-rawdata-collapse"
 class="text-black"
