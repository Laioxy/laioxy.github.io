 半角
 &lt;/label&gt;
 &lt;/div&gt;
 &lt;div class="btn-group mb-1 g-3 text-nowrap"&gt;
 &lt;input
 class="btn-check"
 id="option-space"
 type="radio"
 name="option-space"
 checked /&gt;
 &lt;label class="btn btn-outline-primary" for="option-space"&gt;
 スペースあり
 &lt;/label&gt;
 &lt;input
 class="btn-check"
 id="option-nospace"
